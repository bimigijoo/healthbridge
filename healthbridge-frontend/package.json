{
  "name": "healthbridge-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:ui": "playwright test",
    "test:review-gateway": "node --test scripts/review-postgres-public.test.js",
    "review:public": "node scripts/review-postgres-public.js",
    "review:build": "node scripts/review-postgres-public.js --build-only",
    "demo:preflight": "node scripts/classroom-demo.js preflight",
    "demo:backend": "node scripts/classroom-demo.js backend",
    "demo:frontend": "node scripts/classroom-demo.js frontend",
    "test:demo-config": "node --test scripts/classroom-demo-config.test.js",
    "test:classroom": "npm run demo:preflight && playwright test --config playwright.classroom.config.js",
    "test:live:preflight": "node scripts/check-live-isolation.js",
    "test:live": "npm run test:live:preflight && playwright test --config playwright.live.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "selfsigned": "^5.5.0",
    "vite": "^8.3.0"
  }
}
